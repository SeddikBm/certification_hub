ENV=dev
API_KEY=change-me-to-a-long-random-string
# DEBUG shows every [SCAN]/[LLM]/[ROUTE]/[SCRAPING]/[FUZZY_MATCH]/[EVALUATE]
# step as it happens — useful while testing locally. INFO is enough for normal use.
LOG_LEVEL=DEBUG

# Groq -------------------------------------------------------------------
# NOTE: as of 2026-06-17 Groq deprecated llama-3.1-8b-instant and
# llama-3.3-70b-versatile for free/developer-tier accounts. Check
# https://console.groq.com/docs/models before deploying and update below.
GROQ_API_KEY=gsk_xxx
GROQ_PARSER_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# OCR ----------------------------------------------------------------------
OCR_ENGINE=paddleocr
OCR_LANGUAGES=fr+en
PDF_RENDER_DPI=300
MIN_NATIVE_TEXT_CHARS=40

# Scoring --------------------------------------------------------------------
SCORE_THRESHOLD_APPROVE=0.95
SCORE_THRESHOLD_REJECT=0.60
DATE_TOLERANCE_DAYS=3

# Web verification agent -----------------------------------------------------
# false here = this project's own deliberate choice for local dev/testing on
# your own certificates only (see README "Faisabilité du scraping"). This is
# NOT a safe default for anyone else's deployment — the Settings class
# itself defaults to true; only this local .env overrides it.
RESPECT_ROBOTS_TXT=false

MAX_UPLOAD_MB=15

# Hugging Face ---------------------------------------------------------------
HF_TOKEN=hf_your_token_here
